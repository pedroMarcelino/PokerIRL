# Porta da API + WebSocket
PORT=3000

# "memory" (padrão, sem credenciais) ou "mongodb"
DB_DRIVER=memory

# Necessário somente quando DB_DRIVER=mongodb
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>/?appName=porkerirl
MONGODB_DB=cassino_denso

# Origem liberada no CORS (endereço do React)
CORS_ORIGIN=http://localhost:5173

