# Porta da API + WebSocket
PORT=3000

# "memory" (padrão, sem credenciais) ou "mongodb"
DB_DRIVER=memory

# Necessário somente quando DB_DRIVER=mongodb
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>/?appName=pokerirl
MONGODB_DB=cassino_denso

# Opcional. Sem ele, a API reflete a origem da requisição.
# Na Vercel, as chamadas são no mesmo domínio (/api), então não é obrigatório.
# CORS_ORIGIN=https://seu-dominio.com

