{
  "name": "porkerirl",
  "version": "0.1.0",
  "private": true,
  "description": "Fichas online para poker com cartas fisicas",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "dev:server": "npm run dev --workspace @porkerirl/server",
    "dev:web": "npm run dev --workspace @porkerirl/web",
    "start:server": "npm run start --workspace @porkerirl/server"
  },
  "engines": {
    "node": ">=20"
  }
}
