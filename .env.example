# PokerIRL — modelo das variáveis de ambiente (raiz do monorepo)
# Copie este arquivo para .env e preencha os valores. O .env é ignorado pelo Git;
# este .env.example é versionado e serve só de referência.
#
# Onde cada um é usado:
#   Local (npm run dev:server / docker compose): o servidor lê o .env da raiz.
#   Vercel: copie DB_DRIVER, MONGODB_URI, MONGODB_DB e (opcional) CORS_ORIGIN
#           para Environment Variables no painel do projeto.

# Porta da API e do WebSocket (apenas local/Docker; ignorado na Vercel)
PORT=3000

# "memory" = sem credenciais, estado em memória (some ao reiniciar)
# "mongodb" = grava no Atlas (use este na Vercel)
DB_DRIVER=mongodb

# Necessário quando DB_DRIVER=mongodb: URI do cluster com usuário e senha
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?appName=pokerirl

# Nome do banco. Mantenha o valor atual para não perder as salas já gravadas.
MONGODB_DB=cassino-denso

# Opcional. Sem ele, a API reflete a origem da requisição.
# CORS_ORIGIN=http://localhost:5173
